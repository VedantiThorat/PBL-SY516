def monthly_series(year, month):
    n = calendar.monthrange(year, month)[1]
    rng = np.random.default_rng(year * 100 + month)
    days = np.arange(1, n + 1)
    temp = 27 + 4 * np.sin(days / 5) + rng.normal(0, 0.8, n)
    hum = 65 + 8 * np.cos(days / 6) + rng.normal(0, 2, n)
    df = pd.DataFrame({"Day": days, "Temperature (C)": temp.round(1), "Humidity (%)": hum.round(1)})
    if ss.esp_on and (year, month) == (date.today().year, date.today().month):
        (tt, hh), _ = base_reading()
        df.loc[df["Day"] == date.today().day, ["Temperature (C)", "Humidity (%)"]] = [round(tt, 1), round(hh, 1)]
    return df


def white_fig(fig, h=360):
    fig.update_layout(paper_bgcolor="white", plot_bgcolor="white", height=h, font=dict(color="#111"),
                      margin=dict(l=10, r=10, t=40, b=10), legend=dict(orientation="h", y=-0.2))
    fig.update_xaxes(gridcolor="#eee")
    fig.update_yaxes(gridcolor="#eee")
    return fig


def make_pdf(title, df):  # PDFs stay in English (built-in PDF fonts have no Devanagari)
    if FPDF is None:
        return None
    pdf = FPDF()
    pdf.add_page()
    pdf.set_font("Helvetica", "B", 16)
    pdf.cell(0, 10, "MindSpark - AIB Smart Crop Storage Monitor", new_x="LMARGIN", new_y="NEXT")
    pdf.set_font("Helvetica", "B", 13)
    pdf.cell(0, 9, title, new_x="LMARGIN", new_y="NEXT")
    pdf.set_font("Helvetica", "", 9)
    pdf.cell(0, 6, f"Generated: {datetime.now():%d %b %Y %H:%M}", new_x="LMARGIN", new_y="NEXT")
    pdf.ln(4)
    w = 190 / max(len(df.columns), 1)
    pdf.set_font("Helvetica", "B", 9)
    for col in df.columns:
        pdf.cell(w, 8, str(col)[:18], border=1)
    pdf.ln()
    pdf.set_font("Helvetica", "", 9)
    for _, row in df.iterrows():
        for v in row:
            pdf.cell(w, 7, str(v)[:22].encode("latin-1", "replace").decode("latin-1"), border=1)
        pdf.ln()
    return bytes(pdf.output())


