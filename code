def read_esp32():
    """ESP32 should return JSON like {"temperature": 27.5, "humidity": 64}."""
    if requests is None:
        return None
    try:
        j = requests.get(ss.esp_url, timeout=3).json()
        return float(j["temperature"]), float(j["humidity"])
    except Exception:
        return None


def base_reading():
    if ss.esp_on:
        val = read_esp32()
        if val:
            return val, "ESP32 (live)"
        return (28 + random.uniform(-1, 1), 65 + random.uniform(-3, 3)), "Demo data (ESP32 not reachable)"
    return (28 + random.uniform(-1.5, 1.5), 65 + random.uniform(-4, 4)), "Demo data"


def crop_readings():
    (bt, bh), source = base_reading()
    rows = []
    for i, c in enumerate(ss.crops):
        spec = CROPS[c["crop"]]
        rng = random.Random(f"{c['unit']}{c['crop']}{datetime.now():%Y%m%d%H}")
        if source == "ESP32 (live)" and i == 0:
            tt, hh = bt, bh  # first unit is wired to the ESP32
        else:
            tt = sum(spec["t"]) / 2 + rng.uniform(-4, 6)
            hh = sum(spec["h"]) / 2 + rng.uniform(-8, 12)
        rows.append({**c, "temp": round(tt, 1), "hum": round(min(hh, 100), 1)})
    return rows, source


def risk_calc(c):
    spec = CROPS[c["crop"]]
    td = max(0, spec["t"][0] - c["temp"], c["temp"] - spec["t"][1])
    hd = max(0, spec["h"][0] - c["hum"], c["hum"] - spec["h"][1])
    days = (date.today() - c["stored_on"]).days
    risk = min(100, td * 6 + hd * 1.8 + (days / spec["life"]) * 25)
    left = max(0, round(spec["life"] * (1 - risk / 100) - days))
    return round(risk, 1), left


def status_of(risk):
    if risk < 20:
        return "Very Normal", GREEN, "🟢"
    if risk < 50:
        return "Normal", BLUE, "🔵"
    return "High Risk", RED, "🔴"


readings, source = crop_readings()
for r in readings:
    r["risk"], r["left"] = risk_calc(r)
    r["status"], r["color"], r["dot"] = status_of(r["risk"])


def build_alerts():
    out = []
    for r in readings:
        spec = CROPS[r["crop"]]
        if r["risk"] >= 50:
            lvl, msg = "Critical", f"{t('Spoilage risk')} {r['risk']}% - {t('Immediate action needed')}"
        elif r["risk"] >= 20:
            lvl, msg = "Warning", f"{t('Conditions are getting worse')} ({r['temp']}°C, {r['hum']}%)"
        else:
            lvl, msg = "Info", t("All values are safe")
        if r["temp"] > spec["t"][1]:
            msg += f" | {t('Temperature too high')}"
        if r["hum"] > spec["h"][1]:
            msg += f" | {t('Humidity too high')}"
        out.append({"id": f"{r['unit']}-{r['crop']}", "unit": r["unit"], "crop": r["crop"], "level": lvl, "message": msg})
    return out


