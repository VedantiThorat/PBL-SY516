#include <LiquidCrystal.h>

LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

int tempSensor = A0;
int humiditySensor = A1;

int redLED = 8;
int greenLED = 9;

float temperature;
float humidity;

void setup()
{
    pinMode(redLED, OUTPUT);
    pinMode(greenLED, OUTPUT);

    pinMode(tempSensor, INPUT);
    pinMode(humiditySensor, INPUT);

    lcd.begin(16, 2);

    Serial.begin(9600);

    lcd.setCursor(0, 0);
    lcd.print("CROP MONITOR");
    lcd.setCursor(0, 1);
    lcd.print("System Starting");

    delay(2000);
    lcd.clear();
}

void loop()
{
    // READ TEMPERATURE

    int tempValue = analogRead(tempSensor);

    float voltage = tempValue * (5.0 / 1024.0);

    temperature = (voltage - 0.5) * 100.0;

    // READ HUMIDITY

    int humidityValue = analogRead(humiditySensor);

    humidity = map(humidityValue, 0, 1023, 0, 100);

    // DISPLAY TEMPERATURE AND HUMIDITY

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("Temp:");
    lcd.print(temperature, 1);
    lcd.print((char)223);
    lcd.print("C");

    lcd.setCursor(0, 1);
    lcd.print("Humidity:");
    lcd.print(humidity);
    lcd.print("%");

    Serial.print("Temperature: ");
    Serial.print(temperature);
    Serial.println(" C");

    Serial.print("Humidity: ");
    Serial.print(humidity);
    Serial.println("%");

    delay(2000);

    // CHECK CROP SPOILAGE RISK

    if (temperature >= 30 || humidity >= 80)
    {
        // HIGH RISK CONDITION

        digitalWrite(redLED, HIGH);
        digitalWrite(greenLED, LOW);

        lcd.clear();

        lcd.setCursor(0, 0);
        lcd.print("HIGH RISK OF");

        lcd.setCursor(0, 1);
        lcd.print("CROP SPOILAGE");

        Serial.println("HIGH RISK OF CROP SPOILAGE");

        delay(2000);
    }

    else
    {
        // NORMAL CONDITION

        digitalWrite(redLED, LOW);

        lcd.clear();

        lcd.setCursor(0, 0);
        lcd.print("NO RISK OF CROP");

        lcd.setCursor(0, 1);
        lcd.print("SPOILAGE");

        Serial.println("NO RISK OF CROP SPOILAGE");

        // GREEN LED BLINKING

        for (int i = 0; i < 4; i++)
        {
            digitalWrite(greenLED, HIGH);
            delay(500);

            digitalWrite(greenLED, LOW);
            delay(500);
        }
    }
}
